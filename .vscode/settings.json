{
  "cmake.configureOnOpen": false,
  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_path": "/opt/homebrew/opt/llvm/bin/clang-format",
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "cmake.sourceDirectory": "${workspaceFolder}/register/C",
  "cmake.buildDirectory": "${workspaceFolder}/register/C/build/01_led_blink",
  "cmake.configureSettings": {
    "CMAKE_TOOLCHAIN_FILE": "${workspaceFolder}/cmake/arm-gcc.cmake",
    "CMAKE_BUILD_TYPE": "Debug",
    "APP": "01_led_blink"
  },
  "clangd.path": "/opt/homebrew/opt/llvm/bin/clangd",
  "clangd.arguments": [
    "--background-index",
    "--compile-commands-dir=${workspaceFolder}/register/C/build/01_led_blink",
    "--query-driver=/Users/hangyeonghyeon/zephyr-sdk-1.0.1/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gcc"
  ],
  "rust-analyzer.linkedProjects": [
    "register/Rust/01_hello_world/Cargo.toml",
    "register/Rust/02_led_blink/Cargo.toml",
    "register/Rust/02_gpio_button/Cargo.toml"
  ],
  "rust-analyzer.cargo.target": "thumbv7em-none-eabihf",
  "rust-analyzer.cargo.allTargets": false,
  "rust-analyzer.check.allTargets": false,
  "rust-analyzer.cargo.extraArgs": [
    "--offline",
    "--locked"
  ],
  "rust-analyzer.check.extraArgs": [
    "--offline",
    "--locked"
  ],
  "rust-analyzer.cargo.targetDir": "build/rust-analyzer",
  "files.watcherExclude": {
    "**/build/**": true,
    "**/external/**": true
  },
  "search.exclude": {
    "**/build": true,
    "external": true
  }
}
