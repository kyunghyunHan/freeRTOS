{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C/01_led_blink: Configure",
      "type": "process",
      "command": "/opt/homebrew/bin/cmake",
      "args": [
        "-S",
        "C/01_led_blink",
        "-B",
        "C/01_led_blink/build/nucleo_f446re",
        "-G",
        "Ninja",
        "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/platform/arm-gcc.cmake",
        "-DCMAKE_BUILD_TYPE=Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "C/01_led_blink: Build",
      "type": "process",
      "command": "/opt/homebrew/bin/cmake",
      "args": [
        "--build",
        "C/01_led_blink/build/nucleo_f446re"
      ],
      "dependsOn": "C/01_led_blink: Configure",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
